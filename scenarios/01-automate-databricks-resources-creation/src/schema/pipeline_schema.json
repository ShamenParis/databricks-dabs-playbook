{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Databricks DLT Pipeline Config Schema",
  "type": "object",
  "required": [
    "resource_type",
    "pipeline_bundle_name",
    "pipeline_name",
    "libraries"
  ],
  "properties": {
    "resource_type": {
      "type": "string",
      "enum": [
        "pipeline"
      ]
    },
    "pipeline_bundle_name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 100
    },
    "pipeline_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "catalog": {
      "type": "string",
      "description": "Unity Catalog catalog name"
    },
    "target_schema": {
      "type": "string",
      "description": "Target schema / database for DLT output tables"
    },
    "serverless": {
      "type": "boolean",
      "default": true
    },
    "continuous": {
      "type": "boolean",
      "default": false
    },
    "development_mode": {
      "type": "boolean",
      "default": true
    },
    "channel": {
      "type": "string",
      "enum": [
        "CURRENT",
        "PREVIEW"
      ],
      "default": "CURRENT"
    },
    "photon": {
      "type": "boolean",
      "default": false
    },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "notebook_path": {
            "type": "string"
          },
          "python_file": {
            "type": "string"
          }
        }
      }
    },
    "num_workers": {
      "type": "integer",
      "minimum": 0
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1
    },
    "policy_id": {
      "type": "string"
    },
    "pipeline_config": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pipeline_tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "email_recipients",
          "alerts"
        ],
        "properties": {
          "email_recipients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alerts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level"
        ],
        "properties": {
          "group_name": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "CAN_VIEW",
              "CAN_RUN",
              "CAN_MANAGE"
            ]
          }
        }
      }
    },
    "_comment": {
      "type": "string",
      "description": "Optional comment for documentation purposes"
    }
  },
  "additionalProperties": false
}