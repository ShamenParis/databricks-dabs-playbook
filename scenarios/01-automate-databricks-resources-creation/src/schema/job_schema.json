{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Databricks Job Resource Configuration Schema",
  "description": "Config schema for a Databricks job resource. Set resource_type to 'job'.",
  "type": "object",
  "required": [
    "resource_type",
    "job_bundle_name",
    "job_name",
    "tasks"
  ],
  "properties": {
    "resource_type": {
      "type": "string",
      "enum": [
        "job"
      ]
    },
    "job_bundle_name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique bundle key for this job (alphanumeric, underscore, hyphen)"
    },
    "job_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Human-readable display name shown in Databricks UI"
    },
    "job_cluster_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Required when use_serverless is false"
    },
    "job_run_as": {
      "type": "string",
      "description": "Service principal UUID or email. Optional for free edition."
    },
    "use_serverless": {
      "type": "boolean",
      "default": true,
      "description": "Use serverless compute (free edition). Set false for classic clusters."
    },
    "max_concurrent_runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "warning_duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_key"
        ],
        "properties": {
          "task_key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "notebook_task",
              "python_task",
              "sql_task",
              "run_job_task",
              "pipeline_task"
            ],
            "default": "notebook_task"
          },
          "notebook_path": {
            "type": "string"
          },
          "python_file": {
            "type": "string"
          },
          "sql_query": {
            "type": "string"
          },
          "sql_file": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "WORKSPACE",
              "GIT"
            ]
          },
          "job_id": {
            "type": "integer"
          },
          "job_parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "pipeline_id": {
            "type": "string"
          },
          "full_refresh": {
            "type": "boolean"
          },
          "dependance_task_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "task_parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "warning_duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "max_retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "min_retry_interval_millis": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "schedule_cron_expression": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "pause_status": {
          "type": "boolean"
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "pause_status": {
          "type": "boolean"
        }
      }
    },
    "email_notification": {
      "type": "object",
      "properties": {
        "on_failure_emails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_success_emails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_duration_warning_threshold_exceeded_emails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "job_parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level"
        ],
        "properties": {
          "group_name": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "service_principal_name": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "CAN_VIEW",
              "CAN_MANAGE_RUN",
              "CAN_MANAGE"
            ]
          }
        }
      }
    },
    "_comment": {
      "type": "string",
      "description": "Optional comment for documentation purposes"
    }
  },
  "additionalProperties": false
}